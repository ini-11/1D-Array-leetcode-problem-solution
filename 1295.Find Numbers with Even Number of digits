class Solution {
    public int findNumbers(int[] nums) {
        int t=0;
        for(int b:nums){
            int s=0;
            while(b>0){
                s=s+1;
                b=b/10;
            }
            if(s%2==0){
                t=t+1;
            }
        }
        return t;
    }
}
            
            
        
        
    
